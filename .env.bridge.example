# 复制为服务器上的 .env 后填写真实值。
# 只供 docker-compose.bridge.yml 使用，不要提交真实密码到公开仓库。
# 以下 SECRET_KEY / DATABASE_PASSWORD / REDIS_PASSWORD 为必填项，
# compose 未检测到时会直接报错拒绝启动（fail-closed）。

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=8.155.172.84,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://8.155.172.84:6000
LOGIN_NO_CAPTCHA_AUTH=false

# 生成方式示例：openssl rand -hex 32
SECRET_KEY=请填写随机密钥

DATABASE_ENGINE=django.db.backends.postgresql_psycopg2
DATABASE_NAME=bridge_design_dvadmin3
DATABASE_HOST=172.19.237.131
DATABASE_PORT=5432
DATABASE_USER=bridge_user
DATABASE_PASSWORD=请填写数据库密码

REDIS_PASSWORD=请填写Redis密码

# 未配置时算法服务的 BIMFACE 相关接口返回不可用（503），不影响其他功能
BIMFACE_APP_KEY=请填写BIMFACE_APP_KEY
BIMFACE_APP_SECRET=请填写BIMFACE_APP_SECRET
BIMFACE_FILE_ID=请填写BIMFACE_FILE_ID

# 导师既有两阶段参数模型随算法服务打包，默认启用。
# 仅用于故障排查时临时设为 false；停用后接口会明确返回规则回退来源。
BRIDGE_DESIGN_MODEL_ENABLED=true

# 五节苗节点 Pilot 模型受控接入。默认 false，不影响现有规则链路。
# 启用前将 alpha_model.joblib / beta_model.joblib 放入指定宿主目录；
# 仅使用本项目离线训练产生且经过审核的受信任 joblib 文件。
BRIDGE_NODE_MODEL_ENABLED=false
BRIDGE_NODE_MODEL_HOST_DIR=./bridge_algorithm_service/model_artifacts

# v9 设计人员给定前/后半区的 alpha 双专家。默认关闭；启用后仍复用上面的 v6 beta。
# 请求必须显式传 outer_node_structure_type=front_half 或 back_half。
BRIDGE_NODE_DESIGN_MODE_MODEL_ENABLED=false
